# ============================================================
# BugFlow Elite v6 — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.
# ============================================================

# ── AI APIs (optional — Ollama works without any of these) ──
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Recon API Keys (optional — improves subdomain coverage) ─
GITHUB_TOKEN=
SHODAN_API_KEY=
SECURITYTRAILS_KEY=
VIRUSTOTAL_KEY=
CHAOS_KEY=
URLSCAN_KEY=

# ── HackerOne (required for draft creation) ─────────────────
H1_API_TOKEN=
H1_USERNAME=

# ── Telegram Alerts (required for notifications) ────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ThreatFade (your C2 detection engine) ───────────────────
THREATFADE_URL=http://localhost:8000
THREATFADE_API_KEY=

# ── Bug Bounty Platforms (optional — adds draft creation) ───
BUGCROWD_API_TOKEN=
INTIGRITI_TOKEN=
YESWEHACK_TOKEN=

# ── Ollama Configuration ──────────────────────────────────────────────────────
# Set to true if Ollama is already running (e.g. trading bot uses it)
# When true, BugFlow uses http://172.17.0.1:11434 (Docker host IP)
USE_HOST_OLLAMA=false

# ── Ecosystem Connections (activate after each product deploys) ─────────────
FUSIONOPS_URL=http://13.50.16.19:8080
FUSIONOPS_API_KEY=

AI_SHIELD_URL=http://13.50.16.19:8002
AI_SHIELD_API_KEY=

# Olvrix → BugFlow domain alerts
# Add BUGFLOW_URL=http://YOUR_CONTABO_IP:8502 to Olvrix config.py

# ResilientAI → BugFlow host data
# Add BUGFLOW_URL=http://YOUR_CONTABO_IP:8502 to ResilientAI .env

# ── Web3 / Smart Contract APIs ───────────────────────────────────────────────
# Free API keys: etherscan.io/login → API Keys → Create
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
SNOWTRACE_API_KEY=
